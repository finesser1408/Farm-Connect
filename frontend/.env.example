# Base URL the React app uses for API calls.
#
# Recommended: a relative path. The site's nginx forwards /api/ to Django, so a
# relative value keeps every request on the page's own origin — no CORS and no
# possibility of mixed content.
VITE_API_URL=/api/v1

# Absolute origins are also accepted, but they must match the page's scheme:
# an https:// page may only call https:// endpoints. The client falls back to
# /api/v1 automatically if it ever sees an http:// value on an https page.
# VITE_API_URL=https://farmconnect.zchpc.ac.zw/api/v1

# Development only: Django served directly, no proxy.
# VITE_API_URL=http://127.0.0.1:8000/api/v1