# ── Core ────────────────────────────────────────────────────────────────
# Generate a fresh one:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=replace-me-with-a-generated-secret-key
# MUST be False on the server. True only for local debugging.
DEBUG=False
# Comma separated: public domain, any direct IPs, then loopback.
ALLOWED_HOSTS=farmconnect.zchpc.ac.zw,10.50.103.90,127.0.0.1,localhost
# Public origin of the React app — used to build password reset links and to
# trust CSRF requests coming from the site.
FRONTEND_URL=https://farmconnect.zchpc.ac.zw

# ── PostgreSQL (the only database this project supports - no SQLite) ────
POSTGRES_DB=farmconnect
POSTGRES_USER=farmconnect_user
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── SMTP — read by backend/email_service.py ─────────────────────────────
# Every outgoing message (welcome, order, status, password reset, OTP) is
# delivered through smtplib using these values.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=True
# Shown in the From: header. Falls back to SMTP_USERNAME when unset.
DEFAULT_FROM_EMAIL=Farm Fresh Hub <your-email@gmail.com>

# ── Django's built-in mail backend (admin site password resets) ────────
# Keep these in step with the SMTP block above.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ── Optional ────────────────────────────────────────────────────────────
# Resend is opt-in: the service only uses it when send_email(..., use_resend=True).
RESEND_API_KEY=
# Used by backend/test_api.py when pointing at a non-default host.
API_BASE_URL=https://farmconnect.zchpc.ac.zw/api/v1/auth
