# ── Core ────────────────────────────────────────────────────────────────
# Generate a fresh one:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=replace-me-with-a-generated-secret-key
# MUST be False on the server. True only for local debugging.
DEBUG=False
# Optional for bare-host (non-Docker) runs to load a specific env file explicitly:
# DJANGO_ENV_FILE=.env.development
# Comma separated: public domain, any direct IPs, then loopback.
ALLOWED_HOSTS=farmconnect.zchpc.ac.zw,10.50.103.90,127.0.0.1,localhost
FRONTEND_URL=https://farmconnect.zchpc.ac.zw

# Email Configuration
# Supported providers: "smtp", "resend", or "django" (DEBUG=True only)
PASSWORD_RESET_EMAIL_PROVIDER=smtp
EMAIL_HOST=mails.example.org
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_TIMEOUT=15
EMAIL_HOST_USER=your-official-email@example.org
EMAIL_HOST_PASSWORD=your-smtp-password
DEFAULT_FROM_EMAIL=your-official-email@example.org

# Optional Legacy SMTP Aliases / Resend Configuration
RESEND_API_KEY=
