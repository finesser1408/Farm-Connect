# ── Core ────────────────────────────────────────────────────────────────
# Generate a fresh one:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=replace-me-with-a-generated-secret-key
# MUST be False on the server. True only for local debugging.
DEBUG=False
# Comma separated: public domain, any direct IPs, then loopback.
ALLOWED_HOSTS=farmconnect.zchpc.ac.zw,10.50.103.90,127.0.0.1,localhost
FRONTEND_URL=https://farmconnect.zchpc.ac.zw

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# SMTP Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=True

# Resend Configuration

RESEND_API_KEY=
DEFAULT_FROM_EMAIL=onboarding@resend.dev
